# ---- Secrets: never commit ------------------------------------------------
.env
*.env
collector/.env
collector/.env.bak

# ---- Python ---------------------------------------------------------------
collector/__pycache__/
*.py[cod]
venv/
.pytest_cache/

# ---- Runtime data & logs --------------------------------------------------
*.log
hotnews.db
hotnews.db-wal
hotnews.db-shm

# ---- Generated site content ------------------------------------------------
