# ---- Secrets: never commit ------------------------------------------------
.env
*.env
collector/.env
collector/.env.bak
collector/.env.bak*

# ---- Python ---------------------------------------------------------------
collector/__pycache__/
*.py[cod]
venv/
.pytest_cache/

# ---- Runtime data & logs --------------------------------------------------
*.log
hotnews.db
hotnews.db-wal
hotnews.db-shm

# ---- Generated site content ------------------------------------------------
# 26k+ markdown files are produced from the DB by the pipeline; the database
# is the source of truth, so article content is not versioned here.
# The hand-written pages at the content root (about/privacy/contact) ARE
# versioned: they are site structure, not pipeline output.
site/content/*
!site/content/*.md
site/.hugo_build.lock

# ---- Build output ----------------------------------------------------------
build-output/
