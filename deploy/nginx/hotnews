server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;

    return 301 https://www.little7.net$request_uri;
    root /var/www/hotnews;
    index index.html;

    location / {
        try_files $uri $uri/ =404;
    }

    # GoAccess stats — outside the Hugo build dir so --cleanDestinationDir can't wipe it
    location = /goaccess.html {
        alias /var/www/goaccess/goaccess.html;
    }


    # zh → zh-TW redirect (Traditional Chinese moved to its own language code)
    location ~ ^/zh(/.*)?$ {
        return 301 /zh-tw$1$is_args$args;
    }
    location = /zh {
        return 301 /zh-tw/;
    }
    # Demo game site — independent directory, isolated from Hugo builds
    location /game/ {
        alias /var/www/game/;
        index index.html;
        try_files $uri $uri/ =404;
    }

    location ~* \.(css|js|png|jpg|jpeg|gif|ico|svg|woff2?)$ {
        expires 7d;
        add_header Cache-Control "public";
    }
}
server {
    server_name www.little7.net little7.net; # managed by Certbot

    root /var/www/hotnews;
    index index.html;

