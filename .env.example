# HotNews Daily — environment template.
# Copy to collector/.env and fill in real values. collector/.env is gitignored.

# Rewrite worker output language (always English regardless of source language)
TARGET_LANG=en

# LLM endpoint (Gemini-compatible)
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta
LLM_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite

# Collector: seconds between RSS runs
COLLECT_INTERVAL=600

# Rewrite worker
REWRITE_API_KEYS=
REWRITE_FETCH=500
REWRITE_BATCH=10
REWRITE_SLEEP=5
REWRITE_IDLE=120

# Translation worker (zh-TW / ja / fr / ar)
TRANSLATE_API_KEYS=
TRANSLATE_BATCH=10
TRANSLATE_SLEEP=0
TRANSLATE_LANG_SLEEP=10

# French translation worker (separate key)
TRANSLATE_FR_API_KEYS=
TRANSLATE_FR_BATCH=10
TRANSLATE_FR_SLEEP=0
